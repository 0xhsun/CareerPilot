# Copy this file to .env and fill in the values:
#   cp .env.example .env

# API key — required for AI features (evaluate / cover letter / resume / chat / RAG)
# OpenAI:     https://platform.openai.com/api-keys      (sk-...)
# OpenRouter: https://openrouter.ai/keys                (sk-or-v1-...)
OPENAI_API_KEY=sk-...

# OpenAI-compatible base URL. Leave unset/empty for official OpenAI.
# OpenRouter: https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model ids. OpenRouter requires a vendor prefix (openai/..., anthropic/..., google/...).
# OpenAI defaults:  gpt-5.4-mini  /  text-embedding-3-small
# OPENAI_MODEL=openai/gpt-5.4-mini
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Debug mode — set to false in production
DEBUG=true

# CORS allowed origins — restrict in production, e.g. http://localhost:5173
# CORS_ORIGINS=["http://localhost:5173"]
